<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ro.mpp2025.javaprojectui.gui.Home"
            prefHeight="400.0" prefWidth="600.0">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="header">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                </padding>
                <Label text="Competition Registration System" textFill="BLACK">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </Label>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="userLabel" text="Welcome, User" textFill="BLACK">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Label>
                    <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="secondary-button"
                            text="Logout"/>
                </HBox>
            </HBox>
        </top>
        <center>
            <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
                <Tab text="Events Overview">
                    <BorderPane>
                        <center>
                            <TableView fx:id="eventsTable" prefHeight="200.0" prefWidth="200.0"
                                       BorderPane.alignment="CENTER">
                                <columns>
                                    <TableColumn fx:id="eventNameColumn" prefWidth="200.0" text="Event"/>
                                    <TableColumn fx:id="ageGroupColumn" prefWidth="150.0" text="Age Group"/>
                                    <TableColumn fx:id="registeredCountColumn" prefWidth="150.0"
                                                 text="Registered Participants"/>
                                </columns>
                            </TableView>
                        </center>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </BorderPane>
                </Tab>
                <Tab text="Search Participants">
                    <BorderPane>
                        <top>
                            <VBox spacing="10.0" BorderPane.alignment="CENTER">
                                <padding>
                                    <Insets bottom="15.0" left="10.0" right="10.0" top="15.0"/>
                                </padding>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Label text="Event:"/>
                                    <ComboBox fx:id="searchEventComboBox" prefWidth="200.0"
                                              promptText="Select Event"/>
                                    <Label text="Age Group:"/>
                                    <ComboBox fx:id="searchAgeGroupComboBox" prefWidth="150.0"
                                              promptText="Select Age Group"/>
                                    <Button onAction="#handleSearch" styleClass="primary-button"
                                            text="Search"/>
                                </HBox>
                            </VBox>
                        </top>
                        <center>
                            <TableView fx:id="searchResultsTable" prefHeight="200.0" prefWidth="200.0"
                                       BorderPane.alignment="CENTER">
                                <columns>
                                    <TableColumn fx:id="participantNameColumn" prefWidth="300.0"
                                                 text="Participant Name"/>
                                    <TableColumn fx:id="participantAgeColumn" prefWidth="100.0" text="Age"/>
                                </columns>
                            </TableView>
                        </center>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0"/>
                        </padding>
                    </BorderPane>
                </Tab>
                <Tab text="Register Participant">
                    <BorderPane>
                        <center>
                            <VBox spacing="20.0" BorderPane.alignment="CENTER">
                                <HBox spacing="15.0">
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Participant Name:"/>
                                        <TextField fx:id="participantNameField"/>
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="CNP:"/>
                                        <TextField fx:id="participantCNPField"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="10.0">
                                    <Label text="Select Events (max 2):"/>
                                    <HBox spacing="15.0">
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label text="Event 1:"/>
                                            <ComboBox fx:id="event1ComboBox" prefWidth="200.0"
                                                      promptText="Select Event"/>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label text="Age Group:"/>
                                            <ComboBox fx:id="ageGroup1ComboBox" prefWidth="150.0"
                                                      promptText="Select Age Group"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="15.0">
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label text="Event 2 (optional):"/>
                                            <ComboBox fx:id="event2ComboBox" prefWidth="200.0"
                                                      promptText="Select Event"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <Label fx:id="registrationMessageLabel" styleClass="message-label"
                                       visible="false"/>
                                <HBox alignment="CENTER_RIGHT">
                                    <Button onAction="#handleRegister" styleClass="primary-button"
                                            text="Register Participant"/>
                                </HBox>
                            </VBox>
                        </center>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                    </BorderPane>
                </Tab>
            </TabPane>
        </center>
</BorderPane>
