<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<VBox styleClass="root" stylesheets="/app.css" alignment="CENTER" prefHeight="587.0" prefWidth="715.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.client.gui.Home">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <HBox styleClass="title-label" prefHeight="100.0" prefWidth="600.0">
        <Text>WELCOME, </Text>
        <Label fx:id="userLabel" prefHeight="17.0" prefWidth="200.0" styleClass="title-label"/>
   </HBox>
    <Label styleClass="section-label" text="Rank" />
    <TableView fx:id="clasament" VBox.vgrow="ALWAYS" styleClass="games-table">
        <columns>
            <TableColumn fx:id="usernameColumn" prefWidth="75.0" text="User" />
            <TableColumn fx:id="successfulShotsColumn" prefWidth="120.0" text="Successful Shots" />
            <TableColumn fx:id="scoreColumn" prefWidth="70.0" text="Score" />
            <TableColumn fx:id="startTimeColumn" prefWidth="150.0" text="Start Time" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

<!--    <HBox alignment="CENTER" spacing="20.0">-->
<!--        <Label fx:id="gameStatusLabel" styleClass="info-label" text="Status: LOADING..." />-->
<!--        <Label fx:id="shotsLabel" styleClass="info-label" text="Shots: 0 (Hits: 0)" />-->
<!--        <Label fx:id="scoreLabel" styleClass="info-label" text="Score: 0" />-->
<!--    </HBox>-->

    <GridPane fx:id="table" alignment="CENTER" hgap="5.0" vgap="5.0" styleClass="game-grid">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="50.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        </rowConstraints>
    </GridPane>
    <Button onAction="#handleLogoutButton" styleClass="logout-button" text="Logout" />
</VBox>
